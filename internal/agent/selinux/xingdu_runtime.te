policy_module(xingdu_runtime, 1.0.0)

# Only the pinned protocol executable transitions into this confined domain.
type xingdu_runtime_t;
type xingdu_runtime_exec_t;
init_daemon_domain(xingdu_runtime_t, xingdu_runtime_exec_t)

type xingdu_runtime_conf_t;
files_config_file(xingdu_runtime_conf_t)

# Keep systemd NoNewPrivileges enabled during the domain transition.
allow init_t xingdu_runtime_t:process2 nnp_transition;
allow xingdu_runtime_t self:capability net_bind_service;
allow xingdu_runtime_t self:process { fork signal sigchld signull };
allow xingdu_runtime_t self:fifo_file rw_fifo_file_perms;
allow xingdu_runtime_t self:tcp_socket create_stream_socket_perms;
allow xingdu_runtime_t self:udp_socket create_socket_perms;
allow xingdu_runtime_t self:unix_stream_socket create_stream_socket_perms;
allow xingdu_runtime_t self:netlink_route_socket { create bind read write getattr getopt setopt nlmsg_read };

# Configuration is supplied by systemd on an already-open, root-only fd.
allow init_t xingdu_runtime_conf_t:file { getattr open read ioctl };
allow xingdu_runtime_t xingdu_runtime_conf_t:file { getattr read ioctl lock };
init_use_fds(xingdu_runtime_t)
allow xingdu_runtime_t init_t:fifo_file { getattr write ioctl };

# Proxy destinations and listen ports vary; IP restrictions remain in the
# runtime route rules. No filesystem write, shell execution or metadata grant.
corenet_tcp_sendrecv_generic_if(xingdu_runtime_t)
corenet_udp_sendrecv_generic_if(xingdu_runtime_t)
corenet_tcp_sendrecv_generic_node(xingdu_runtime_t)
corenet_udp_sendrecv_generic_node(xingdu_runtime_t)
corenet_tcp_bind_generic_node(xingdu_runtime_t)
corenet_udp_bind_generic_node(xingdu_runtime_t)
corenet_tcp_bind_all_ports(xingdu_runtime_t)
corenet_udp_bind_all_ports(xingdu_runtime_t)
corenet_tcp_connect_all_ports(xingdu_runtime_t)
corenet_sendrecv_all_client_packets(xingdu_runtime_t)
corenet_sendrecv_all_server_packets(xingdu_runtime_t)
sysnet_dns_name_resolve(xingdu_runtime_t)
files_read_etc_files(xingdu_runtime_t)
libs_search_lib(xingdu_runtime_t)
miscfiles_read_localization(xingdu_runtime_t)
miscfiles_read_generic_certs(xingdu_runtime_t)
kernel_read_system_state(xingdu_runtime_t)
kernel_read_network_state(xingdu_runtime_t)
kernel_read_kernel_sysctls(xingdu_runtime_t)
dev_read_urand(xingdu_runtime_t)
dev_rw_null(xingdu_runtime_t)
logging_send_syslog_msg(xingdu_runtime_t)

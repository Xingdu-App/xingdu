[
  {
    "id": "builtin:all-proxy",
    "name": "全部使用节点",
    "description": "所有匹配流量使用所选节点，不添加直连例外。",
    "rules": [],
    "final_action": "proxy"
  },
  {
    "id": "builtin:lan-direct",
    "name": "局域网直连 · 其余代理",
    "description": "私有网段与 .lan / .local 直连，其余使用节点；不代表完整的局域网发现或 DNS 配置。",
    "rules": [
      {
        "type": "domain_suffix",
        "value": "lan",
        "target": "direct"

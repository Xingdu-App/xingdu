# Local development only. Replace before any deployment.
POSTGRES_PASSWORD=xingdu-local-dev
XINGDU_APP_DATABASE_PASSWORD=xingdu-app-local-dev-only
# URL-encode reserved characters when supplying DATABASE_URL manually.
DATABASE_URL=postgres://xingdu_app:xingdu-app-local-dev-only@127.0.0.1:54329/xingdu?sslmode=disable
# Docker API startup migrates automatically; Compose supplies the owner URL.
# For other container deployments, inject XINGDU_MIGRATION_DATABASE_URL via secrets.
# Set XINGDU_AUTO_MIGRATE=false only when a release job already ran migrations.
XINGDU_HTTP_ADDR=127.0.0.1:18080
XINGDU_PUBLIC_ORIGIN=http://127.0.0.1:15173

# Explicitly enable sign-up for a hosted SaaS instance.
XINGDU_REGISTRATION_ENABLED=false

# Separate restricted queue worker. Change all development credentials before deployment.
XINGDU_WORKER_DATABASE_PASSWORD=xingdu-worker-local-dev-only
# SSH installation stays disabled without a 32-byte key (64 hex characters).
# Generate once with: openssl rand -hex 32
XINGDU_CREDENTIAL_KEY=
# A remote VPS must reach a trusted HTTPS origin. Loopback is for local Agent tests only.
XINGDU_AGENT_ORIGIN=http://127.0.0.1:15173
# Optional operator-controlled private SSH subnets, never populated from tenant input.
XINGDU_SSH_ALLOWED_CIDRS=

# Email verification is mandatory for public self-registration.
# Missing/placeholder credentials disable delivery; no account is created.
RESEND_API_KEY=PLACEHOLDER_REPLACE_WITH_RESEND_API_KEY
XINGDU_EMAIL_FROM=Xingdu <noreply@xingdu.app>

# Optional OAuth providers. Configure separate apps per deployment origin.
# Empty/placeholder credentials keep that provider disabled.
XINGDU_GOOGLE_CLIENT_ID=
XINGDU_GOOGLE_CLIENT_SECRET=
XINGDU_GITHUB_CLIENT_ID=
XINGDU_GITHUB_CLIENT_SECRET=

# Free self-hosting by default. Cloud mode requires all Stripe settings below.
MODE=self_hosted
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# USD 500 cents/month and USD 4000 cents/year, recurring, quantity 1.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_YEARLY=
# Cancellation at period end, invoice history and payment updates enabled;
# subscription price/quantity changes disabled. See docs/BILLING.md.
STRIPE_PORTAL_CONFIGURATION=

# Optional public-site GA4 measurement ID. Build-time only; empty disables analytics.
VITE_GA_MEASUREMENT_ID=

# Optional paid tenant certificate management. Provider secrets belong only to API.
# Empty values disable issuance. Both domains must lie in the configured CF zone.
XINGDU_CERTIFICATE_VALIDATION_DOMAIN=
XINGDU_CERTIFICATE_PLATFORM_DOMAIN=
XINGDU_CERTIFICATE_CLOUDFLARE_TOKEN=
XINGDU_CERTIFICATE_CLOUDFLARE_ZONE=
XINGDU_CERTIFICATE_EMAIL=
XINGDU_CERTIFICATE_STATE_DIR=/var/lib/xingdu/certificate-state/acme
XINGDU_CERTIFICATE_ACCEPT_TOS=false
# Staging by default; test certificates cannot be applied to nodes.
XINGDU_CERTIFICATE_PRODUCTION=false

# Local development only. Replace before any deployment.
POSTGRES_PASSWORD=xingdu-local-dev
XINGDU_APP_DATABASE_PASSWORD=xingdu-app-local-dev-only
# URL-encode reserved characters when supplying DATABASE_URL manually.
DATABASE_URL=postgres://xingdu_app:xingdu-app-local-dev-only@127.0.0.1:54329/xingdu?sslmode=disable
XINGDU_HTTP_ADDR=127.0.0.1:18080
XINGDU_PUBLIC_ORIGIN=http://127.0.0.1:15173

# Explicitly enable sign-up for a hosted SaaS instance.
XINGDU_REGISTRATION_ENABLED=false

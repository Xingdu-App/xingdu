diff --git a/protocol/direct/xingdu_udp.go b/protocol/direct/xingdu_udp.go
new file mode 100644
index 0000000..5d31d7b
--- /dev/null
+++ b/protocol/direct/xingdu_udp.go
@@ -0,0 +1,57 @@
+package direct
+
+import (
+	"net"
+	"net/netip"
+)
+
+// Xingdu server runtime: validate every resolved UDP destination, including
+// destination changes inside an already-routed association. Drop only the
+// rejected datagram so the authenticated public flow can continue.
+var xingduDeniedUDP = []netip.Prefix{
+	netip.MustParsePrefix("0.0.0.0/8"),
+	netip.MustParsePrefix("10.0.0.0/8"),
+	netip.MustParsePrefix("100.64.0.0/10"),
+	netip.MustParsePrefix("127.0.0.0/8"),
+	netip.MustParsePrefix("169.254.0.0/16"),
+	netip.MustParsePrefix("172.16.0.0/12"),
+	netip.MustParsePrefix("192.168.0.0/16"),
+	netip.MustParsePrefix("168.63.129.16/32"),
+	netip.MustParsePrefix("224.0.0.0/4"),
+	netip.MustParsePrefix("240.0.0.0/4"),
+	netip.MustParsePrefix("::/128"),
+	netip.MustParsePrefix("::1/128"),
+	netip.MustParsePrefix("fc00::/7"),
+	netip.MustParsePrefix("fe80::/10"),
+	netip.MustParsePrefix("ff00::/8"),
+}
+
+func xingduPublicUDP(ip netip.Addr) bool {
+	if !ip.IsValid() {
+		return false
+	}
+	ip = ip.Unmap()
+	for _, prefix := range xingduDeniedUDP {
+		if prefix.Contains(ip) {
+			return false
+		}
+	}
+	return true
+}
+
+// Do not expose Upstream or syscall.Conn: bulk-copy optimizations must not
+// unwrap this guard and write directly to the underlying socket.
+type xingduPacketConn struct{ net.PacketConn }
+
+func (c *xingduPacketConn) WriteTo(p []byte, addr net.Addr) (int, error) {
+	// Resolve once and send to that exact checked address, avoiding DNS rebinding.
+	resolved, err := net.ResolveUDPAddr("udp", addr.String())
+	if err != nil {
+		return len(p), nil
+	}
+	ip, ok := netip.AddrFromSlice(resolved.IP)
+	if !ok || !xingduPublicUDP(ip) {
+		return len(p), nil
+	}
+	return c.PacketConn.WriteTo(p, resolved)
+}
diff --git a/protocol/direct/xingdu_udp_test.go b/protocol/direct/xingdu_udp_test.go
new file mode 100644
index 0000000..1131f11
--- /dev/null
+++ b/protocol/direct/xingdu_udp_test.go
@@ -0,0 +1,22 @@
+package direct
+
+import (
+	"net/netip"
+	"testing"
+)
+
+func TestXingduUDPPerPacketDestinations(t *testing.T) {
+	for _, address := range []string{"127.0.0.1", "::ffff:127.0.0.1", "10.1.2.3", "169.254.169.254", "168.63.129.16", "100.64.1.1", "172.16.0.1", "192.168.0.1", "0.1.2.3", "224.0.0.1", "240.0.0.1", "::", "::1", "fc00::1", "fe80::1", "ff02::1"} {
+		if xingduPublicUDP(netip.MustParseAddr(address)) {
+			t.Errorf("accepted private destination %s", address)
+		}
+	}
+	for _, address := range []string{"93.184.216.34", "::ffff:93.184.216.34", "2606:4700:4700::1111"} {
+		if !xingduPublicUDP(netip.MustParseAddr(address)) {
+			t.Errorf("rejected public destination %s", address)
+		}
+	}
+	if xingduPublicUDP(netip.Addr{}) {
+		t.Fatal("accepted invalid IP")
+	}
+}

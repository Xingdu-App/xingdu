[Unit]
Description=Xingdu external protocol probe
After=network-online.target
Wants=network-online.target
[Service]
DynamicUser=yes
EnvironmentFile=/etc/xingdu/probe.env
ExecStart=/usr/local/bin/xingdu-probe
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077
[Install]
WantedBy=multi-user.target

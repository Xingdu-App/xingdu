resolver ${XINGDU_DNS_RESOLVERS} valid=10s ipv6=off;
upstream xingdu_api {
    zone xingdu_api 64k;
    server ${XINGDU_API_UPSTREAM} resolve;
}
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    # Credentials may appear in subscription query strings. Suppress both logs.
    location ~ ^/api/v1/subscriptions/[^/]+/content$ {
        access_log off;
        error_log /dev/null crit;
        proxy_pass http://xingdu_api;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }
    location /api/ { proxy_pass http://xingdu_api; proxy_connect_timeout 3s; proxy_read_timeout 10s; }
    location = /health/web { access_log off; return 200 'ok\n'; add_header Content-Type text/plain; }
    location /health/ { proxy_pass http://xingdu_api; proxy_connect_timeout 3s; proxy_read_timeout 10s; }
    location /assets/ { try_files $uri =404; }
    location = / { try_files /index.html =404; }
    location ~ ^/(pricing|privacy|security|app|login)/?$ { try_files /$1/index.html =404; }
    location ~ ^/app/(overview|hosts|nodes|routes|subscriptions|deployments|members|profile|security|settings)/?$ { try_files /app/index.html =404; }
    error_page 404 /404.html;
    location = /404.html { internal; }
    location / { try_files $uri $uri/ =404; }
}

resolver ${XINGDU_DNS_RESOLVERS} valid=10s ipv6=off;
upstream xingdu_api {
    zone xingdu_api 64k;
    server ${XINGDU_API_UPSTREAM} resolve;
}
server {
    listen 8080;
    server_name _;
    # Keep redirects on the public origin behind TLS proxies and mapped ports.
    absolute_redirect off;
    root /usr/share/nginx/html;
    index index.html;
    # Credentials may appear in subscription query strings. Suppress both logs.
    location ~ ^/api/v1/subscriptions/[^/]+/content$ {
        access_log off;
        error_log /dev/null crit;
        proxy_pass http://xingdu_api;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }
    # OAuth codes and state are transient credentials, including on upstream errors.
    location ~ ^/api/v1/auth/oauth/[^/]+/callback$ {
        access_log off;
        error_log /dev/null crit;
        add_header Referrer-Policy no-referrer always;
        add_header Cache-Control no-store always;
        proxy_pass http://xingdu_api;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }
    location /api/v1/billing { access_log off; proxy_pass http://xingdu_api; proxy_connect_timeout 3s; proxy_read_timeout 30s; }
    location /api/ { proxy_pass http://xingdu_api; proxy_connect_timeout 3s; proxy_read_timeout 10s; }
    location = /health/web { access_log off; return 200 'ok\n'; add_header Content-Type text/plain; }
    location /health/ { proxy_pass http://xingdu_api; proxy_connect_timeout 3s; proxy_read_timeout 10s; }
    location /assets/ { try_files $uri =404; }
    location = / { try_files /index.html =404; }
    location = /index.html { return 308 /$is_args$args; }
    location ~ ^/(blog(?:/[a-z0-9-]+)?|pricing|privacy|security|help|service)/(?:index\.html)?$ { return 308 /$1$is_args$args; }
    location ~ ^/(pricing|privacy|security|help|service|blog|app|login)/?$ { try_files /$1/index.html =404; }
    location ~ ^/app/(overview|hosts|nodes|routes|subscriptions|deployments|members|profile|security|settings|billing)/?$ { try_files /app/index.html =404; }
    location ~ ^/blog/[a-z0-9-]+/?$ { try_files $uri/index.html =404; }
    error_page 404 /404.html;
    location = /404.html { internal; }
    location / { try_files $uri $uri/ =404; }
}
